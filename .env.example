# 复制本文件为 .env 后填写。只有第一段是必填的，其他按需填写，改完重启网页服务。

# ===== 大模型（必填）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# OpenAI：LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# 本地 Ollama（无需 Key）：LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5

# ===== 邮箱（可选）=====
# 密码处要填「授权码 / 应用专用密码」，不是登录密码。
# Gmail:   imap.gmail.com / smtp.gmail.com（需开启两步验证后生成 App password）
# iCloud:  imap.mail.me.com / smtp.mail.me.com，SMTP 端口 587
# QQ邮箱:  imap.qq.com / smtp.qq.com
# 163邮箱: imap.163.com / smtp.163.com
# 注意：Outlook/Hotmail 个人邮箱已不支持密码登录，暂不可用。
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_PORT=465

# ===== 微信推送（可选，二选一或都填）=====
# Server酱：推送到你的个人微信。到 https://sct.ftqq.com 用微信扫码登录，复制 SendKey
SERVERCHAN_KEY=
# 企业微信群机器人：群设置 → 添加群机器人 → 复制 Webhook 地址
WECOM_WEBHOOK_URL=

# ===== 网页搜索（可选）=====
# 不填默认用 DuckDuckGo。填了 Tavily（https://tavily.com，有免费额度）结果更稳定
TAVILY_API_KEY=

# 数据目录（默认是项目下的 data/）
# AGENT_DATA_DIR=~/.personal-agent
